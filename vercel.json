{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/record",
      "destination": "/static/mobile.html"
    },
    {
      "source": "/dashboard",
      "destination": "/static/dashboard.html"
    },
    {
      "source": "/inspect",
      "destination": "/scg_inspection_dashboard.html"
    },
    {
      "source": "/architecture",
      "destination": "/architecture.html"
    },
    {
      "source": "/report-approval",
      "destination": "/advisor_approval_report.html"
    },
    {
      "source": "/anatomy",
      "destination": "/mems_scg_anatomy.html"
    },
    {
      "source": "/report-handbook",
      "destination": "/member_b_handbook_and_report.html"
    }
  ]
}
